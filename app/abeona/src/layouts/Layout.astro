---
import { themeBootstrapScript } from "@nexus/ui";
import "../styles/global.css";
import {
  getBaseUrl,
  getWebsiteDescription,
  getWebsiteTitle,
} from "../lib/config";
import { ABEONA_THEMES } from "../lib/themes";

interface Props {
  title?: string;
  description?: string;
  /** Pages that only a link opens (the share status page) stay out of search engines. */
  noindex?: boolean;
}

const baseUrl = getBaseUrl();
const assetBase = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
const siteTitle = getWebsiteTitle();
const siteDescription = getWebsiteDescription();
const { title = "", description = siteDescription, noindex = false } = Astro.props;
const themeColor = "#1f6f5c";
const themeScript = themeBootstrapScript("abeona_theme", ABEONA_THEMES);
---

<!doctype html>
<html
  lang="en"
  data-theme="abeona"
  data-base-url={baseUrl}
  data-site-title={siteTitle}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="manifest" href={assetBase + "manifest.webmanifest"} />
    <link rel="shortcut icon" href={`${assetBase}favicon.ico`} />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={`${assetBase}favicon-32x32.png`}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href={`${assetBase}favicon-16x16.png`}
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={`${assetBase}apple-touch-icon.png`}
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={themeColor} />
    <title>{title ? `${title} | ${siteTitle}` : siteTitle}</title>

    <script is:inline set:html={themeScript}></script>

    <script is:inline>
      // Register from the app's base, not relative to the page: GitHub Pages
      // redirects /nexus/<app> to /nexus/<app>/, and a page-relative "sw.js"
      // resolved before that redirect points one level too high and 404s.
      (function () {
        if (
          "serviceWorker" in navigator &&
          window.location.protocol !== "file:"
        ) {
          var base = document.documentElement.dataset.baseUrl || "/";
          if (!base.endsWith("/")) base += "/";
          window.addEventListener("load", function () {
            navigator.serviceWorker
              .register(base + "sw.js", { scope: base })
              .catch(function (e) {
                console.error("Service worker registration failed:", e);
              });
          });
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-base-100 text-base-content">
    <slot />
  </body>
</html>
