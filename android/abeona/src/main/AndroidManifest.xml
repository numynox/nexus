<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The live companion: an ongoing notification and heads-up alerts,
         kept alive by a foreground service while a trip is under way. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- The companion keeps the CPU on while it follows a trip, so it keeps
         updating with the screen off; and its notification is a Live Update
         (Android 16+: pinned at the top, a chip in the status bar). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- The companion starts by itself before a departure from an exact alarm:
         Android 12+ lets a foreground service start from one, not from a
         background job. USE_EXACT_ALARM is granted on install (13+); the app
         is sideloaded, so Play's restriction on it does not apply. Android 12
         asks for SCHEDULE_EXACT_ALARM instead. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <!-- Optional, asked for on the trip screen: the phone's position while the
         live companion runs (near a stop, moving along the line, missed the
         change). Foreground only: no background location. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- "Open DB Navigator": Android 11+ hides other apps unless they are named here. -->
    <queries>
        <package android:name="de.hafas.android.db" />
    </queries>

    <application
        android:name=".AbeonaApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Abeona.Starting">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Intake: "Share" from DB Navigator (text), or a ticket PDF from
                 mail or files. Read on the phone, then looked up and saved. -->
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!-- Starts the live companion before a departure (live/Background.kt). -->
        <receiver
            android:name=".live.CompanionAlarmReceiver"
            android:exported="false" />

        <!-- Refreshes the trip every minute during a ride; with the
             "Use location during a trip" setting it also follows the
             phone's position, only while it runs. -->
        <service
            android:name=".live.LiveCompanionService"
            android:exported="false"
            android:foregroundServiceType="dataSync|location" />

        <!-- The home screen widget: the next departure. -->
        <receiver
            android:name=".widget.NextTripWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_trip_widget" />
        </receiver>
    </application>
</manifest>
