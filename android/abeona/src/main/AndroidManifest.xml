<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The live companion: an ongoing notification and heads-up alerts,
         kept alive by a foreground service while a trip is under way. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Optional, asked for on the trip screen: the phone's position while the
         live companion runs (near a stop, moving along the line, missed the
         change). Foreground only: no background location. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- "Open DB Navigator": Android 11+ hides other apps unless they are named here. -->
    <queries>
        <package android:name="de.hafas.android.db" />
    </queries>

    <application
        android:name=".AbeonaApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Abeona.Starting">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Refreshes the trip every two minutes during a ride; with the
             "Use location during a trip" setting it also follows the
             phone's position, only while it runs. -->
        <service
            android:name=".live.LiveCompanionService"
            android:exported="false"
            android:foregroundServiceType="dataSync|location" />

        <!-- The home screen widget: the next departure. -->
        <receiver
            android:name=".widget.NextTripWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_trip_widget" />
        </receiver>
    </application>
</manifest>
